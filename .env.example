# ── Server ────────────────────────────────────────────────────────────────────
PORT=5050
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_PORT=3306
DB_NAME=bizmate

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ── Email / SMTP ──────────────────────────────────────────────────────────────
# Leave blank to disable email notifications (invoices/payments will still work)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@example.com
SMTP_PASS=your_smtp_password
# Display name + address used in From header (defaults to SMTP_USER if omitted)
SMTP_FROM="BizMate <noreply@example.com>"
